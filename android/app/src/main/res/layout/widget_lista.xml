<?xml version="1.0" encoding="utf-8"?>
<!-- El widget de lista: cabecera (título, buscar, +) y las notas debajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_fondo"
    android:clipToOutline="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="10dp">
        <TextView
            android:id="@+id/titulo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/widget_lista"
            android:textColor="@color/text"
            android:fontFamily="@font/geist"
            android:textFontWeight="500"
            android:textSize="19sp" />
        <ImageView
            android:id="@+id/buscar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:contentDescription="@string/atajo_buscar"
            android:src="@drawable/ic_w_buscar" />
        <ImageView
            android:id="@+id/nueva"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="4dp"
            android:contentDescription="@string/nueva_nota"
            android:src="@drawable/ic_w_mas" />
    </LinearLayout>
    <ListView
        android:id="@+id/lista"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbars="none" />
    <TextView
        android:id="@+id/vacio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/sin_notas"
        android:textColor="@color/muted"
        android:textSize="14sp" />
</LinearLayout>
