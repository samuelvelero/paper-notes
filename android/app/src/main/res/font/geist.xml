<?xml version="1.0" encoding="utf-8"?>
<!-- Geist como UNA familia con sus cuatro pesos, para los widgets: con el
     archivo suelto (@font/geist_bold) el launcher que no carga las fuentes de
     la app cae a la del sistema en REGULAR y la negrita de «Hoy» se pierde.
     Con la familia y textFontWeight/textStyle, si no la carga cae a la del
     sistema pero con el peso que toca. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/geist_regular" />
    <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/geist_medium" />
    <font android:fontStyle="normal" android:fontWeight="600" android:font="@font/geist_semibold" />
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/geist_bold" />
</font-family>
