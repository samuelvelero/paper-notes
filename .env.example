# Copia a .env en el servidor (nunca se versiona).
# Superusuario de PocketBase (panel /_/ desde la tailnet). NO es la cuenta
# con la que se usa la app: esa es un usuario normal de la colección `users`.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=cambia-esto
TZ=America/Lima
# Secreto entre PocketBase y el buscador (el hook lo manda en X-Index-Token).
# Genera uno: openssl rand -hex 24
INDEX_TOKEN=cambia-esto
# Modelo de embeddings (fastembed). Español+inglés, 0.64 GB. Alternativa más
# ligera: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_MODEL=jinaai/jina-embeddings-v2-base-es
